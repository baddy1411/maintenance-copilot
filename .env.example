# Copy to .env (git-ignored) and fill in. Never commit .env.
# `make env` adds any missing DB_PASSWORD_* lines with random values, so you only need to set the API key.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Hard cap for spike LLM spend, enforced in spikes/common.py from real usage.cost
SPIKE_BUDGET_USD=1.00

ENV=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=copilot
# Superuser, used only by the Postgres container's init script (bootstrap). Local only.
POSTGRES_PASSWORD=
# One login per role (DESIGN §5.2).
DB_PASSWORD_MIGRATOR=
DB_PASSWORD_APP_RW=
DB_PASSWORD_TOOLS_RO=
DB_PASSWORD_INGEST_RW=
DB_PASSWORD_MCP_RW=

# Salt for the pseudonymous user ids in the cost ledger and rate limits. `make env` generates one.
USER_HASH_SALT=

# Auth (docs/auth.md). Locally, `make env` creates a dev signing key; get a token with
#   uv run copilot dev-token --user tech-1 --role technician
# Outside ENV=local/test the dev key is refused: set JWT_PUBLIC_KEY (PEM) and JWT_ISSUER from your identity provider.
DEV_JWT_KEY_FILE=
JWT_PUBLIC_KEY=
# CORS_ORIGINS=["http://localhost:5173"]
